data/**/*.hdf5
data/**/*.tsv
*.bam
*.bai
*.cram
*.fasta
*.fa
*.fa.fai

# Model artefacts
models/*.pkl
models/*.joblib
models/*.h5
models/*.dat

# Outputs (regenerable)
outputs/*.png
outputs/*.pdf
outputs/*.json

# Secrets and credentials
.env
*.pem
